{{ 'section-footer.css' | asset_url | stylesheet_tag }}
{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}

<style>
  .footer-mustang {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding: 60px 20px 40px;
    margin-top: {{ section.settings.margin_top }}px;
  }

  .footer-mustang .page-width {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* ========== SEPARADORES A ANCHO COMPLETO ========== */
  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 40px;
    margin-bottom: 60px;
    padding-bottom: 40px;
    border-bottom: 1px solid {{ section.settings.border_color }};
    position: relative;
    width: 100%;
  }

  /* Separador vertical - ANCHO COMPLETO */
  .footer-top::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1px;
    background-color: {{ section.settings.border_color }};
    transform: translateX(-50%);
  }

  /* Logo - Izquierda (Desktop) */
  .footer-logo {
    flex: 1;
    text-align: left;
  }

  .footer-logo .logo-img {
    max-width: {{ section.settings.logo_width }}px;
    margin-bottom: 15px;
  }

  .footer-logo .logo-img img {
    width: 100%;
    height: auto;
    display: block;
  }

  .footer-logo .country {
    font-size: 12px;
    color: {{ section.settings.text_color | append: 'cc' }};
    margin-top: 10px;
  }

  /* Newsletter - Derecha */
  .footer-newsletter {
    flex: 1;
    text-align: left;
  }

  .footer-newsletter h3 {
    font-size: 18px;
    font-weight: 600;
    margin: 0 0 10px 0;
    color: #ffffff;
  }

  .footer-newsletter .newsletter-text {
    font-size: 13px;
    margin-bottom: 20px;
    color: {{ section.settings.text_color | append: 'cc' }};
  }

  .footer-newsletter .checkbox {
    margin: 20px 0;
    font-size: 12px;
  }

  .footer-newsletter .checkbox label {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    cursor: pointer;
  }

  .footer-newsletter .checkbox input {
    width: 16px;
    height: 16px;
    margin-top: 2px;
    cursor: pointer;
  }

  .footer-newsletter .checkbox .checkbox-text {
    flex: 1;
  }

  .newsletter-form {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    align-items: center;
  }

  .newsletter-form .email-field {
    flex: 1;
    min-width: 250px;
  }

  .newsletter-form .email-field label {
    display: block;
    font-size: 12px;
    margin-bottom: 5px;
    color: {{ section.settings.text_color | append: 'aa' }};
  }

  .newsletter-form .email-field input {
    width: 100%;
    padding: 12px 15px;
    border: 1px solid {{ section.settings.border_color }};
    background-color: transparent;
    color: {{ section.settings.text_color }};
    font-size: 14px;
  }

  .newsletter-form .email-field input::placeholder {
    color: {{ section.settings.text_color | append: '88' }};
  }

  .newsletter-form button {
    padding: 12px 30px;
    background-color: transparent;
    border: 1px solid {{ section.settings.border_color }};
    color: {{ section.settings.text_color }};
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s;
    margin-top: 20px;
  }

  .newsletter-form button:hover {
    background-color: {{ section.settings.text_color }};
    color: {{ section.settings.bg_color }};
  }

  /* ========== PARTE INFERIOR: Menús en Desktop (5 columnas) ========== */
  .footer-menus {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 30px;
    width: 100%;
  }

  .footer-menu-col {
    padding: 0;
  }

  .footer-menu-col h3 {
    font-size: 14px;
    font-weight: 600;
    margin: 0 0 20px 0;
    letter-spacing: 1px;
    color: #ffffff;
  }

  .footer-menu-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-menu-col li {
    margin-bottom: 12px;
  }

  .footer-menu-col a {
    color: {{ section.settings.text_color }};
    text-decoration: none;
    font-size: 13px;
  }

  .footer-menu-col a:hover {
    text-decoration: underline;
  }

  /* Estilo para texto plano (Atención al cliente) */
  .footer-menu-col .plain-text {
    font-size: 13px;
    line-height: 1.6;
    color: {{ section.settings.text_color }};
  }

  .footer-menu-col .plain-text p {
    margin: 0 0 10px 0;
  }

  .footer-menu-col .plain-text .hours {
    font-size: 11px;
    color: {{ section.settings.text_color | append: 'aa' }};
    margin-top: 15px;
  }

  /* Logo móvil (oculto en desktop) */
  .footer-logo-mobile {
    display: none;
  }

  /* ========== ESTILOS PARA MÓVIL ========== */
  @media (max-width: 768px) {
    /* Ocultar el logo de desktop */
    .footer-logo {
      display: none;
    }

    /* Mostrar logo al final del footer */
    .footer-logo-mobile {
      display: block;
      margin-top: 40px;
      padding-top: 30px;
      border-top: 1px solid {{ section.settings.border_color }};
      text-align: center;
      width: 100%;
    }

    .footer-logo-mobile .logo-img {
      max-width: 120px;
      margin: 0 auto 15px;
    }

    .footer-logo-mobile .logo-img img {
      width: 100%;
      height: auto;
    }

    .footer-logo-mobile .country {
      font-size: 12px;
      color: {{ section.settings.text_color | append: 'cc' }};
    }

    /* Menús en acordeón (desplegables) - Excepto Atención al cliente */
    .footer-menus {
      display: block;
      width: 100%;
    }

    .footer-menu-col {
      border-bottom: 1px solid {{ section.settings.border_color }};
    }

    .footer-menu-col h3 {
      margin: 0;
      padding: 15px 0;
      font-size: 16px;
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: relative;
    }

    /* El título de Atención al cliente NO tiene flecha (no es desplegable) */
    .footer-menu-col.service-plain h3 {
      cursor: default;
    }

    .footer-menu-col.service-plain h3::after {
      content: none !important;
    }

    .footer-menu-col:not(.service-plain) h3::after {
      content: "+";
      font-size: 20px;
      font-weight: 300;
      transition: transform 0.3s;
    }

    .footer-menu-col:not(.service-plain).active h3::after {
      content: "−";
    }

    .footer-menu-col:not(.service-plain) ul {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease-out;
      padding: 0;
    }

    .footer-menu-col:not(.service-plain).active ul {
      max-height: 500px;
      padding-bottom: 20px;
    }

    /* El texto plano siempre visible */
    .footer-menu-col.service-plain .plain-text {
      display: block;
      padding-bottom: 20px;
    }

    .footer-menu-col li {
      margin-bottom: 12px;
    }

    /* Newsletter en móvil */
    .footer-top {
      flex-direction: column;
      gap: 30px;
      width: 100%;
    }

    .footer-top::after {
      display: none;
    }

    .footer-newsletter {
      width: 100%;
      text-align: left;
    }

    .newsletter-form {
      flex-direction: column;
      align-items: stretch;
    }

    .newsletter-form button {
      width: 100%;
    }

    .footer-newsletter .checkbox label {
      justify-content: flex-start;
    }
  }
</style>

<footer class="footer-mustang">
  <div class="page-width">
    
    <!-- PARTE SUPERIOR: Logo (izquierda) + Newsletter (derecha) con separador vertical -->
    <div class="footer-top">
      
      <!-- Logo Mustang - IZQUIERDA (solo desktop) -->
      <div class="footer-logo">
        {% if section.settings.logo != blank %}
          <div class="logo-img">
            <img src="{{ section.settings.logo | img_url: 'master' }}" alt="MUSTANG">
          </div>
        {% else %}
          <div class="logo-img" style="background-color: #333; min-height: 80px; display: flex; align-items: center; justify-content: center; font-size: 12px; color: #999;">
            Sube tu logo aquí
          </div>
        {% endif %}
        <div class="country">{{ section.settings.country_text }}</div>
      </div>
      
      <!-- Newsletter - DERECHA -->
      <div class="footer-newsletter">
        <h3>{{ section.settings.newsletter_title }}</h3>
        <div class="newsletter-text">{{ section.settings.newsletter_text }}</div>
        
        <div class="checkbox">
          <label>
            <input type="checkbox" id="newsletter_consent">
            <span class="checkbox-text">{{ section.settings.checkbox_text }}</span>
          </label>
        </div>
        
        {%- form 'customer', id: 'ContactFooter', class: 'newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="email-field">
            <label>{{ section.settings.email_label }}</label>
            <input type="email" name="contact[email]" placeholder="{{ section.settings.placeholder_text }}" required>
          </div>
          <button type="submit">{{ section.settings.button_text }}</button>
        {%- endform -%}
      </div>
      
    </div>
    
    <!-- PARTE INFERIOR: Menús -->
    <div class="footer-menus" id="footer-menus-mobile">
      {%- for block in section.blocks -%}
        {%- if block.type == 'link_list' -%}
          <div class="footer-menu-col" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h3 class="menu-title">{{ block.settings.heading }}</h3>
            {%- endif -%}
            {%- if block.settings.menu != blank -%}
              <ul>
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        {%- elsif block.type == 'customer_service' -%}
          <div class="footer-menu-col service-plain" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h3>{{ block.settings.heading }}</h3>
            {%- endif -%}
            <div class="plain-text">
              {{ block.settings.service_content }}
              {% if block.settings.show_hours %}
                <div class="hours">{{ block.settings.hours_content }}</div>
              {% endif %}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <!-- Logo MÓVIL (aparece al final del footer) -->
    <div class="footer-logo-mobile">
      {% if section.settings.logo != blank %}
        <div class="logo-img">
          <img src="{{ section.settings.logo | img_url: 'master' }}" alt="MUSTANG">
        </div>
      {% else %}
        <div style="font-size: 24px; font-weight: bold;">MUSTANG</div>
      {% endif %}
      <div class="country">{{ section.settings.country_text }}</div>
    </div>
    
  </div>
</footer>

<script>
  // Script para acordeón en móvil (solo para menús normales, no para Atención al cliente)
  document.addEventListener('DOMContentLoaded', function() {
    var menuCols = document.querySelectorAll('.footer-menu-col:not(.service-plain)');
    
    menuCols.forEach(function(col) {
      var title = col.querySelector('.menu-title');
      if (title) {
        title.addEventListener('click', function() {
          col.classList.toggle('active');
        });
      }
    });
  });
</script>

{% schema %}
{
  "name": "Footer Mustang",
  "settings": [
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo",
      "default": "#0082CA"
    },
    {
      "type": "color",
      "id": "text_color",
