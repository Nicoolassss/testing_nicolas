        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer Mustang",
      "blocks": [
        { "type": "link_list" },
        { "type": "link_list" },
        { "type": "link_list" },
        { "type": "link_list" },
        { "type": "customer_service" }
      ]
    }
  ]
}
