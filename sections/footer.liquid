{{ 'section-footer.css' | asset_url | stylesheet_tag }}

<style>
  .footer-mustang {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding: 60px 20px 40px;
    margin-top: {{ section.settings.margin_top }}px;
  }

  .footer-mustang .page-width {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* Grid de 5 columnas iguales */
  .footer-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0;
    border-left: 1px solid {{ section.settings.border_color }};
  }

  /* Cada columna */
  .footer-col {
    padding: 0 30px;
    border-right: 1px solid {{ section.settings.border_color }};
  }

  /* Logo */
  .footer-logo .logo-img {
    max-width: 120px;
    margin-bottom: 20px;
  }

  .footer-logo .logo-img img {
    width: 100%;
    height: auto;
  }

  .footer-logo .mustang-text {
    font-size: 24px;
    font-weight: bold;
    letter-spacing: 2px;
    margin-bottom: 15px;
    display: block;
  }

  .country {
    font-size: 12px;
    color: {{ section.settings.text_color | append: 'cc' }};
    line-height: 1.5;
  }

  /* Títulos de columna */
  .footer-col h3 {
    font-size: 14px;
    font-weight: 600;
    margin: 0 0 20px 0;
    letter-spacing: 1px;
  }

  /* Listas */
  .footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-col li {
    margin-bottom: 12px;
  }

  .footer-col a {
    color: {{ section.settings.text_color }};
    text-decoration: none;
    font-size: 13px;
  }

  .footer-col a:hover {
    text-decoration: underline;
  }

  /* Texto de contacto */
  .footer-col p {
    margin: 0 0 10px 0;
    font-size: 13px;
    line-height: 1.6;
  }

  /* Horario atención */
  .hours {
    font-size: 11px;
    color: {{ section.settings.text_color | append: 'aa' }};
    margin-top: 15px;
    line-height: 1.6;
  }

  /* Fila inferior con reseñas */
  .footer-bottom {
    margin-top: 50px;
    padding-top: 25px;
    display: flex;
    justify-content: flex-end;
    border-top: 1px solid {{ section.settings.border_color }};
  }

  .footer-bottom img {
    max-height: 35px;
    width: auto;
  }

  /* Responsive */
  @media (max-width: 1000px) {
    .footer-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .footer-col {
      padding: 20px;
    }
  }

  @media (max-width: 700px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 500px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
    .footer-bottom {
      justify-content: center;
    }
  }
</style>

<footer class="footer-mustang">
  <div class="page-width">
    <div class="footer-grid">
      
      <!-- Columna 1: Logo + "Estás comprando en: España" -->
      <div class="footer-col footer-logo">
        {% if section.settings.logo != blank %}
          <div class="logo-img">
            <img src="{{ section.settings.logo | img_url: '300x' }}" alt="MUSTANG">
          </div>
        {% else %}
          <span class="mustang-text">MUSTANG</span>
        {% endif %}
        <div class="country">{{ section.settings.country_text }}</div>
      </div>

      <!-- Columna 2: Ayuda -->
      <div class="footer-col">
        <h3>{{ section.settings.menu_title_1 }}</h3>
        <ul>
          {% for link in section.settings.menu_1.links %}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {% endfor %}
        </ul>
      </div>

      <!-- Columna 3: Políticas de marca -->
      <div class="footer-col">
        <h3>{{ section.settings.menu_title_2 }}</h3>
        <ul>
          {% for link in section.settings.menu_2.links %}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {% endfor %}
        </ul>
      </div>

      <!-- Columna 4: Sobre MTNG -->
      <div class="footer-col">
        <h3>{{ section.settings.menu_title_3 }}</h3>
        <ul>
          {% for link in section.settings.menu_3.links %}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {% endfor %}
        </ul>
      </div>

      <!-- Columna 5: Contacto (redes sociales) -->
      <div class="footer-col">
        <h3>{{ section.settings.contact_title }}</h3>
        <div class="contact-content">
          {{ section.settings.contact_content }}
        </div>
      </div>

    </div>

    <!-- Fila extra: Atención al cliente (debajo de las 5 columnas) -->
    <div style="margin-top: 40px; display: flex; justify-content: flex-start;">
      <div style="width: 20%; padding-right: 30px; border-right: 1px solid {{ section.settings.border_color }};">
        <h3 style="font-size: 14px; font-weight: 600; margin: 0 0 20px 0;">{{ section.settings.service_title }}</h3>
        <div class="service-content" style="font-size: 13px; line-height: 1.6;">
          {{ section.settings.service_content }}
        </div>
        {% if section.settings.show_hours %}
          <div class="hours" style="margin-top: 15px; font-size: 11px;">
            {{ section.settings.hours_content }}
          </div>
        {% endif %}
      </div>
    </div>

    <!-- Fila inferior con reseñas -->
    <div class="footer-bottom">
      {% if section.settings.reviews_image != blank %}
        <img src="{{ section.settings.reviews_image | img_url: '200x' }}" alt="Reseñas">
      {% endif %}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer Mustang",
  "settings": [
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del texto",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Color de las líneas divisorias",
      "default": "#333333"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Margen superior",
      "default": 0
    },
    {
      "type": "header",
      "content": "Columna 1 - Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo de Mustang"
    },
    {
      "type": "textarea",
      "id": "country_text",
      "label": "Texto de ubicación",
      "default": "Estás comprando en:\nEspaña"
    },
    {
      "type": "header",
      "content": "Columna 2 - Ayuda"
    },
    {
      "type": "text",
      "id": "menu_title_1",
      "label": "Título",
      "default": "Ayuda"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "Seleccionar menú"
    },
    {
      "type": "header",
      "content": "Columna 3 - Políticas de marca"
    },
    {
      "type": "text",
      "id": "menu_title_2",
      "label": "Título",
      "default": "Políticas de marca"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Seleccionar menú"
    },
    {
      "type": "header",
      "content": "Columna 4 - Sobre MTNG"
    },
    {
      "type": "text",
      "id": "menu_title_3",
      "label": "Título",
      "default": "SOBRE MTNG"
    },
    {
      "type": "link_list",
      "id": "menu_3",
      "label": "Seleccionar menú"
    },
    {
      "type": "header",
      "content": "Columna 5 - Contacto (Redes Sociales)"
    },
    {
      "type": "text",
      "id": "contact_title",
      "label": "Título",
      "default": "CONTACTO"
    },
    {
      "type": "richtext",
      "id": "contact_content",
      "label": "Redes sociales",
      "default": "<p>Facebook<br>Instagram<br>Pinterest<br>TikTok</p>"
    },
    {
      "type": "header",
      "content": "Atención al cliente (fila aparte)"
    },
    {
      "type": "text",
      "id": "service_title",
      "label": "Título",
      "default": "ATENCIÓN AL CLIENTE"
    },
    {
      "type": "richtext",
      "id": "service_content",
      "label": "Contacto",
      "default": "<p>Email<br>+34 965 02 63 34</p>"
    },
    {
      "type": "checkbox",
      "id": "show_hours",
      "label": "Mostrar horario",
      "default": true
    },
    {
      "type": "richtext",
      "id": "hours_content",
      "label": "Horario",
      "default": "<p>Lunes a jueves de 9:00h a 14:00h y de 15:00h a 18:00h<br>Viernes de 9:00h a 13:00h</p>"
    },
    {
      "type": "header",
      "content": "Imagen de reseñas"
    },
    {
      "type": "image_picker",
      "id": "reviews_image",
      "label": "Imagen de reseñas"
    }
  ],
  "presets": [
    {
      "name": "Footer Mustang",
      "category": "Footer"
    }
  ]
}
{% endschema %}