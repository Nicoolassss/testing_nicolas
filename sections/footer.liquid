{{ 'section-footer.css' | asset_url | stylesheet_tag }}

<style>
  .footer-mustang {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding: 50px 20px 30px;
    margin-top: {{ section.settings.margin_top }}px;
  }

  .footer-mustang .page-width {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 15px;
  }

  /* Grid de 6 columnas (logo + 5 menús) */
  .footer-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr 1fr 1fr;
    gap: 30px;
    margin-bottom: 40px;
  }

  /* Logo */
  .footer-logo img {
    max-width: 150px;
    height: auto;
    margin-bottom: 15px;
  }

  .footer-logo .country {
    font-size: 12px;
    color: {{ section.settings.text_color | append: 'aa' }};
    margin-top: 10px;
  }

  /* Títulos de cada columna */
  .footer-col h3 {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 20px;
    color: {{ section.settings.heading_color }};
  }

  /* Listas de enlaces */
  .footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-col li {
    margin-bottom: 10px;
  }

  .footer-col a {
    color: {{ section.settings.text_color }};
    text-decoration: none;
    font-size: 14px;
  }

  .footer-col a:hover {
    text-decoration: underline;
  }

  /* Texto de contacto */
  .footer-col p {
    margin: 0 0 8px 0;
    font-size: 14px;
    line-height: 1.5;
  }

  /* Horario atención */
  .hours {
    font-size: 12px;
    color: {{ section.settings.text_color | append: 'aa' }};
    margin-top: 15px;
  }

  /* Fila inferior con reseñas */
  .footer-bottom {
    border-top: 1px solid {{ section.settings.border_color }};
    padding-top: 25px;
    display: flex;
    justify-content: flex-end;
  }

  .footer-bottom img {
    max-height: 40px;
    width: auto;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 30px;
    }
  }

  @media (max-width: 600px) {
    .footer-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .footer-bottom {
      justify-content: center;
    }
  }
</style>

<footer class="footer-mustang">
  <div class="page-width">
    <div class="footer-grid">
      
      <!-- Columna 1: Logo Mustang -->
      <div class="footer-col footer-logo">
        {% if section.settings.logo != blank %}
          <img src="{{ section.settings.logo | img_url: '300x' }}" alt="{{ shop.name }}">
        {% else %}
          <div style="font-size: 24px; font-weight: bold;">MUSTANG</div>
        {% endif %}
        <div class="country">{{ section.settings.country_text }}</div>
      </div>

      <!-- Columna 2: Menú - Ayuda -->
      <div class="footer-col">
        <h3>{{ section.settings.menu_title_1 }}</h3>
        <ul>
          {% for link in section.settings.menu_1.links %}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {% endfor %}
        </ul>
      </div>

      <!-- Columna 3: Menú - Políticas -->
      <div class="footer-col">
        <h3>{{ section.settings.menu_title_2 }}</h3>
        <ul>
          {% for link in section.settings.menu_2.links %}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {% endfor %}
        </ul>
      </div>

      <!-- Columna 4: Menú - Sobre MTNG -->
      <div class="footer-col">
        <h3>{{ section.settings.menu_title_3 }}</h3>
        <ul>
          {% for link in section.settings.menu_3.links %}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {% endfor %}
        </ul>
      </div>

      <!-- Columna 5: Contacto -->
      <div class="footer-col">
        <h3>{{ section.settings.contact_title }}</h3>
        {{ section.settings.contact_content }}
      </div>

      <!-- Columna 6: Atención al cliente -->
      <div class="footer-col">
        <h3>{{ section.settings.service_title }}</h3>
        {{ section.settings.service_content }}
        {% if section.settings.show_hours %}
          <div class="hours">{{ section.settings.hours_content }}</div>
        {% endif %}
      </div>

    </div>

    <!-- Fila inferior con reseñas -->
    <div class="footer-bottom">
      {% if section.settings.reviews_image != blank %}
        <img src="{{ section.settings.reviews_image | img_url: '200x' }}" alt="Reseñas">
      {% endif %}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer Mustang",
  "settings": [
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del texto",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color de títulos",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Color del borde",
      "default": "#333333"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Margen superior",
      "default": 0
    },
    {
      "type": "header",
      "content": "Logo y texto"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo de Mustang"
    },
    {
      "type": "text",
      "id": "country_text",
      "label": "Texto de ubicación",
      "default": "Estás comprando en: España"
    },
    {
      "type": "header",
      "content": "Menú 1 - Ayuda"
    },
    {
      "type": "text",
      "id": "menu_title_1",
      "label": "Título",
      "default": "Ayuda"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "Seleccionar menú"
    },
    {
      "type": "header",
      "content": "Menú 2 - Políticas"
    },
    {
      "type": "text",
      "id": "menu_title_2",
      "label": "Título",
      "default": "Políticas de marca"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Seleccionar menú"
    },
    {
      "type": "header",
      "content": "Menú 3 - Sobre MTNG"
    },
    {
      "type": "text",
      "id": "menu_title_3",
      "label": "Título",
      "default": "SOBRE MTNG"
    },
    {
      "type": "link_list",
      "id": "menu_3",
      "label": "Seleccionar menú"
    },
    {
      "type": "header",
      "content": "Contacto"
    },
    {
      "type": "text",
      "id": "contact_title",
      "label": "Título",
      "default": "CONTACTO"
    },
    {
      "type": "richtext",
      "id": "contact_content",
      "label": "Contenido",
      "default": "<p>Facebook<br>Instagram<br>Pinterest<br>Tik Tok</p>"
    },
    {
      "type": "header",
      "content": "Atención al cliente"
    },
    {
      "type": "text",
      "id": "service_title",
      "label": "Título",
      "default": "ATENCIÓN AL CLIENTE"
    },
    {
      "type": "richtext",
      "id": "service_content",
      "label": "Información de contacto",
      "default": "<p>Email<br>+34 965 02 63 34</p>"
    },
    {
      "type": "checkbox",
      "id": "show_hours",
      "label": "Mostrar horario",
      "default": true
    },
    {
      "type": "richtext",
      "id": "hours_content",
      "label": "Horario",
      "default": "<p>Lunes a jueves de 9:00h a 14:00h y de 15:00h a 18:00h<br>Viernes de 9:00h a 13:00h</p>"
    },
    {
      "type": "header",
      "content": "Imagen de reseñas"
    },
    {
      "type": "image_picker",
      "id": "reviews_image",
      "label": "Imagen de reseñas"
    }
  ],
  "presets": [
    {
      "name": "Footer Mustang",
      "category": "Footer"
    }
  ]
}
{% endschema %}