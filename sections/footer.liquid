      "default": "Estás comprando en: España"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "Título",
      "default": "Suscríbete a nuestra newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_text",
      "label": "Texto descriptivo",
      "default": "Sé el primero en enterarte de nuestras novedades"
    },
    {
      "type": "text",
      "id": "checkbox_text",
      "label": "Texto del checkbox",
      "default": "Deseo suscribirme a la newsletter de Mtng. He leído y acepto la política de privacidad."
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Etiqueta del campo email",
