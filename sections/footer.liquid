{{ 'section-footer.css' | asset_url | stylesheet_tag }}

<style>
  .footer-mustang {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding: 60px 20px 40px;
    margin-top: {{ section.settings.margin_top }}px;
  }

  .footer-mustang .page-width {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* Grid de 5 columnas iguales con líneas verticales */
  .footer-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0;
    border-left: 1px solid {{ section.settings.border_color }};
  }

  /* Cada columna */
  .footer-col {
    padding: 0 30px;
    border-right: 1px solid {{ section.settings.border_color }};
  }

  /* Logo */
  .footer-logo .logo-img {
    max-width: 120px;
    margin-bottom: 20px;
  }

  .footer-logo .logo-img img {
    width: 100%;
    height: auto;
  }

  .footer-logo .mustang-text {
    font-size: 24px;
    font-weight: bold;
    letter-spacing: 2px;
    margin-bottom: 15px;
    display: block;
  }

  .country {
    font-size: 12px;
    color: {{ section.settings.text_color | append: 'cc' }};
    line-height: 1.5;
  }

  /* Títulos de columna */
  .footer-col h3 {
    font-size: 14px;
    font-weight: 600;
    margin: 0 0 20px 0;
    letter-spacing: 1px;
  }

  /* Listas de menús */
  .footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-col li {
    margin-bottom: 12px;
  }

  .footer-col a {
    color: {{ section.settings.text_color }};
    text-decoration: none;
    font-size: 13px;
  }

  .footer-col a:hover {
    text-decoration: underline;
  }

  /* Fila inferior con reseñas */
  .footer-bottom {
    margin-top: 50px;
    padding-top: 25px;
    display: flex;
    justify-content: flex-end;
    border-top: 1px solid {{ section.settings.border_color }};
  }

  .footer-bottom img {
    max-height: 35px;
    width: auto;
  }

  /* Responsive */
  @media (max-width: 1000px) {
    .footer-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .footer-col {
      padding: 20px;
    }
  }

  @media (max-width: 700px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 500px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
    .footer-bottom {
      justify-content: center;
    }
  }
</style>

<footer class="footer-mustang">
  <div class="page-width">
    <div class="footer-grid">
      
      <!-- Columna 1: Logo + "Estás comprando en: España" (FIJO) -->
      <div class="footer-col footer-logo">
        {% if section.settings.logo != blank %}
          <div class="logo-img">
            <img src="{{ section.settings.logo | img_url: '300x' }}" alt="MUSTANG">
          </div>
        {% else %}
          <span class="mustang-text">MUSTANG</span>
        {% endif %}
        <div class="country">{{ section.settings.country_text }}</div>
      </div>

      <!-- AQUI VAN TUS 4 MENÚS CONFIGURABLES DESDE SHOPIFY -->
      <!-- Las columnas 2, 3, 4, 5 las agregas TÚ desde el personalizador -->
      {%- for block in section.blocks -%}
        {%- if block.type == 'link_list' -%}
          <div class="footer-col" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h3>{{ block.settings.heading }}</h3>
            {%- endif -%}
            {%- if block.settings.menu != blank -%}
              <ul>
                {%- for link in block.settings.menu.links -%}
                  <li>
                    <a href="{{ link.url }}" class="link link--text list-menu__item list-menu__item--link{% if link.active %} list-menu__item--active{% endif %}">
                      {{ link.title }}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}

    </div>

    <!-- Fila inferior con reseñas -->
    <div class="footer-bottom">
      {% if section.settings.reviews_image != blank %}
        <img src="{{ section.settings.reviews_image | img_url: '200x' }}" alt="Reseñas">
      {% endif %}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer Mustang",
  "settings": [
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del texto",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Color de las líneas divisorias",
      "default": "#333333"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Margen superior",
      "default": 0
    },
    {
      "type": "header",
      "content": "Logo y texto fijo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo de Mustang"
    },
    {
      "type": "textarea",
      "id": "country_text",
      "label": "Texto de ubicación",
      "default": "Estás comprando en:\nEspaña"
    },
    {
      "type": "header",
      "content": "Imagen de reseñas"
    },
    {
      "type": "image_picker",
      "id": "reviews_image",
      "label": "Imagen de reseñas"
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Menú",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Título del menú",
          "default": "Título"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Seleccionar menú",
          "info": "Crea los menús en Online Store > Navegación"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer Mustang",
      "blocks": [
        { "type": "link_list" },
        { "type": "link_list" },
        { "type": "link_list" },
        { "type": "link_list" }
      ]
    }
  ]
}
{% endschema %}