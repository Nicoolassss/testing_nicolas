    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Texto del botón",
      "default": "ENVIAR"
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Menú",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "Título del menú"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Seleccionar menú"
        }
      ]
    },
    {
      "type": "customer_service",
      "name": "Atención al cliente (texto plano)",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "Atención al cliente"
        },
        {
          "type": "richtext",
          "id": "service_content",
          "label": "Contenido",
          "default": "<p>Email<br>+34 965 02 63 34</p>"
        },
        {
          "type": "checkbox",
          "id": "show_hours",
