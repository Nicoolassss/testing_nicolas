{{ 'section-footer.css' | asset_url | stylesheet_tag }}
{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}

<style>
  .footer-mustang {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding: 60px 20px 40px;
    margin-top: {{ section.settings.margin_top }}px;
  }

  .footer-mustang .page-width {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* ========== PARTE SUPERIOR: Logo (izquierda) + Newsletter (derecha) ========== */
  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 40px;
    margin-bottom: 60px;
    padding-bottom: 40px;
    border-bottom: 1px solid {{ section.settings.border_color }};
    position: relative;
  }

  /* Separador vertical entre logo y newsletter */
  .footer-top::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1px;
    background-color: {{ section.settings.border_color }};
    transform: translateX(-50%);
  }

  /* Logo - Izquierda */
  .footer-logo {
    flex: 1;
    text-align: left;
  }

  .footer-logo .logo-img {
    max-width: {{ section.settings.logo_width }}px;
    margin-bottom: 15px;
  }

  .footer-logo .logo-img img {
    width: 100%;
    height: auto;
    display: block;
  }

  .footer-logo .country {
    font-size: 12px;
    color: {{ section.settings.text_color | append: 'cc' }};
    margin-top: 10px;
  }

  /* Newsletter - Derecha */
  .footer-newsletter {
    flex: 1;
    text-align: right;
  }

  .footer-newsletter h3 {
    font-size: 18px;
    font-weight: 600;
    margin: 0 0 10px 0;
  }

  .footer-newsletter .newsletter-text {
    font-size: 13px;
    margin-bottom: 20px;
    color: {{ section.settings.text_color | append: 'cc' }};
  }

  .footer-newsletter .checkbox {
    margin: 15px 0;
    font-size: 12px;
  }

  .footer-newsletter .checkbox label {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    cursor: pointer;
  }

  .footer-newsletter .checkbox input {
    width: 16px;
    height: 16px;
    cursor: pointer;
  }

  .newsletter-form {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .newsletter-form input {
    flex: 1;
    padding: 12px 15px;
    border: 1px solid {{ section.settings.border_color }};
    background-color: transparent;
    color: {{ section.settings.text_color }};
    font-size: 14px;
    min-width: 200px;
  }

  .newsletter-form input::placeholder {
    color: {{ section.settings.text_color | append: '88' }};
  }

  .newsletter-form button {
    padding: 12px 30px;
    background-color: transparent;
    border: 1px solid {{ section.settings.border_color }};
    color: {{ section.settings.text_color }};
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s;
  }

  .newsletter-form button:hover {
    background-color: {{ section.settings.text_color }};
    color: {{ section.settings.bg_color }};
  }

  /* ========== PARTE INFERIOR: 5 Menús ========== */
  .footer-menus {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0;
    border-left: 1px solid {{ section.settings.border_color }};
  }

  .footer-menu-col {
    padding: 0 25px;
    border-right: 1px solid {{ section.settings.border_color }};
  }

  .footer-menu-col h3 {
    font-size: 14px;
    font-weight: 600;
    margin: 0 0 20px 0;
    letter-spacing: 1px;
  }

  .footer-menu-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-menu-col li {
    margin-bottom: 12px;
  }

  .footer-menu-col a {
    color: {{ section.settings.text_color }};
    text-decoration: none;
    font-size: 13px;
  }

  .footer-menu-col a:hover {
    text-decoration: underline;
  }

  /* Responsive */
  @media (max-width: 1000px) {
    .footer-menus {
      grid-template-columns: repeat(3, 1fr);
    }
    .footer-menu-col {
      padding: 20px;
    }
    .footer-top {
      flex-direction: column;
      gap: 30px;
    }
    .footer-top::after {
      display: none;
    }
    .footer-newsletter {
      text-align: left;
      width: 100%;
    }
    .footer-newsletter .checkbox label {
      justify-content: flex-start;
    }
    .newsletter-form {
      justify-content: flex-start;
    }
    .footer-logo {
      width: 100%;
    }
  }

  @media (max-width: 700px) {
    .footer-menus {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 500px) {
    .footer-menus {
      grid-template-columns: 1fr;
    }
  }
</style>

<footer class="footer-mustang">
  <div class="page-width">
    
    <!-- PARTE SUPERIOR: Logo (izquierda) + Newsletter (derecha) con separador vertical -->
    <div class="footer-top">
      
      <!-- Logo Mustang - IZQUIERDA (espacio para tu foto) -->
      <div class="footer-logo">
        {% if section.settings.logo != blank %}
          <div class="logo-img">
            <img src="{{ section.settings.logo | img_url: 'master' }}" alt="MUSTANG">
          </div>
        {% else %}
          <div class="logo-img" style="background-color: #333; min-height: 80px; display: flex; align-items: center; justify-content: center; font-size: 12px; color: #999;">
            Sube tu logo aquí
          </div>
        {% endif %}
        <div class="country">{{ section.settings.country_text }}</div>
      </div>
      
      <!-- Newsletter - DERECHA -->
      <div class="footer-newsletter">
        <h3>{{ section.settings.newsletter_title }}</h3>
        <div class="newsletter-text">{{ section.settings.newsletter_text }}</div>
        
        {%- form 'customer', id: 'ContactFooter', class: 'newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input type="email" name="contact[email]" placeholder="{{ section.settings.placeholder_text }}" required>
          <button type="submit">{{ section.settings.button_text }}</button>
        {%- endform -%}
        
        <div class="checkbox">
          <label>
            <input type="checkbox" checked disabled>
            <span>{{ section.settings.checkbox_text }}</span>
          </label>
        </div>
      </div>
      
    </div>
    
    <!-- PARTE INFERIOR: 5 Menús -->
    <div class="footer-menus">
      {%- for block in section.blocks -%}
        <div class="footer-menu-col" {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}
            <h3>{{ block.settings.heading }}</h3>
          {%- endif -%}
          
          {%- if block.type == 'link_list' and block.settings.menu != blank -%}
            <ul>
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    
  </div>
</footer>

{% schema %}
{
  "name": "Footer Mustang",
  "settings": [
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del texto",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Color de las líneas divisorias",
      "default": "#333333"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Margen superior",
      "default": 0
    },
    {
      "type": "header",
      "content": "Logo Mustang"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo de Mustang",
      "info": "Sube la imagen del logo de Mustang"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 250,
      "step": 5,
      "unit": "px",
      "label": "Ancho del logo",
      "default": 150
    },
    {
      "type": "text",
      "id": "country_text",
      "label": "Texto de ubicación",
      "default": "Estás comprando en: España"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "Título",
      "default": "Suscríbete a nuestra newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_text",
      "label": "Texto descriptivo",
      "default": "Sé el primero en enterarte de nuestras novedades"
    },
    {
      "type": "text",
      "id": "placeholder_text",
      "label": "Texto del input",
      "default": "Correo electrónico"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Texto del botón",
      "default": "ENVIAR"
    },
    {
      "type": "text",
      "id": "checkbox_text",
      "label": "Texto del checkbox",
      "default": "Deseo suscribirme a la newsletter de Mtng. He leído y acepto la política de privacidad."
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Menú",
      "limit": 5,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "Título del menú"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Seleccionar menú",
          "info": "Crea tus menús en Online Store > Navegación"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer Mustang",
      "blocks": [
        { "type": "link_list" },
        { "type": "link_list" },
        { "type": "link_list" },
        { "type": "link_list" },
        { "type": "link_list" }
      ]
    }
  ]
}
{% endschema %}