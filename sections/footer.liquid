      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Color de las líneas divisorias",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
