<style>
  .rgt-section {
    background-color: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
    text-align: {{ section.settings.text_align }};
  }

  .rgt-inner {
    max-width: {{ section.settings.content_width }}px;
    margin: 0 auto;
  }

  .rgt-eyebrow {
    font-family: inherit;
    font-size: 11px;
    letter-spacing: {{ section.settings.eyebrow_letter_spacing }}px;
    text-transform: uppercase;
    color: {{ section.settings.eyebrow_color }};
    margin: 0 0 25px 0;
    font-weight: 400;
  }

  .rgt-title {
    font-family: inherit;
    font-size: clamp(28px, 4vw, {{ section.settings.title_size }}px);
    font-weight: 300;
    color: {{ section.settings.title_color }};
    margin: 0 0 35px 0;
    line-height: 1.15;
    letter-spacing: {{ section.settings.title_letter_spacing }}px;
  }

  .rgt-text {
    font-family: inherit;
    font-size: {{ section.settings.text_size }}px;
    color: {{ section.settings.text_color }};
    line-height: 1.9;
    margin: 0 auto 0;
    max-width: 600px;
    letter-spacing: {{ section.settings.text_letter_spacing }}px;
  }

  .rgt-text p {
    margin: 0 0 16px 0;
  }

  .rgt-text p:last-child {
    margin-bottom: 0;
  }

  .rgt-divider {
    width: 40px;
    height: 1px;
    background-color: {{ section.settings.title_color }};
    margin: 0 auto 30px;
  }

  {% if section.settings.text_align == 'left' %}
    .rgt-divider { margin-left: 0; }
    .rgt-text { margin-left: 0; }
  {% elsif section.settings.text_align == 'right' %}
    .rgt-divider { margin-right: 0; margin-left: auto; }
    .rgt-text { margin-left: auto; margin-right: 0; }
  {% endif %}

  @media (max-width: 768px) {
    .rgt-title {
      font-size: clamp(24px, 6vw, 36px);
    }
    .rgt-text {
      font-size: 15px;
    }
  }
</style>

<section class="rgt-section">
  <div class="rgt-inner">

    {%- if section.settings.eyebrow != blank -%}
      <p class="rgt-eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if section.settings.show_divider -%}
      <div class="rgt-divider"></div>
    {%- endif -%}

    {%- if section.settings.title != blank -%}
      <{{ section.settings.title_tag }} class="rgt-title">
        {{ section.settings.title }}
      </{{ section.settings.title_tag }}>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="rgt-text">{{ section.settings.text }}</div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Rich Text Gunni",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Contenido"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto pequeño superior",
      "default": "Gunni & Trentino"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Mostrar línea divisora",
      "default": false
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Gunni & Trentino"
    },
    {
      "type": "select",
      "id": "title_tag",
      "label": "Etiqueta HTML del título",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" },
        { "value": "p", "label": "Párrafo (p)" },
        { "value": "span", "label": "Span" },
        { "value": "div", "label": "Div" }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto descriptivo",
      "default": "<p>Servicios integrales para proyectos de arquitectura e interiorismo. Llevamos 55 años transformando cada proyecto en una experiencia única, con soluciones completas que abarcan todas nuestras áreas de especialización.</p>"
    },
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Alineación",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 400,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "label": "Ancho máximo del contenido",
      "default": 800
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Espacio superior",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Espacio inferior",
      "default": 120
    },
    {
      "type": "header",
      "content": "Tipografía"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Tamaño del título",
      "default": 48
    },
    {
      "type": "range",
      "id": "title_letter_spacing",
      "min": -2,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Espacio entre letras — Título",
      "default": 2
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Tamaño del texto",
      "default": 16
    },
    {
      "type": "range",
      "id": "text_letter_spacing",
      "min": -2,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Espacio entre letras — Texto",
      "default": 0
    },
    {
      "type": "range",
      "id": "eyebrow_letter_spacing",
      "min": -2,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Espacio entre letras — Eyebrow",
      "default": 4
    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fondo",
      "default": "#f0ede8"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Color eyebrow",
      "default": "#999999"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Color título",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color texto",
      "default": "#666666"
    }
  ],
  "presets": [
    {
      "name": "Rich Text Gunni"
    }
  ]
}
{% endschema %}